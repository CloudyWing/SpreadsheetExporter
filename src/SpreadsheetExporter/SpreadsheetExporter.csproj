<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>SpreadsheetExporter 核心函式庫，提供試算表匯出的基底架構。</Description>
  </PropertyGroup>
  <PropertyGroup>
    <!-- RS0027：新增的多載與既有帶選擇性參數的多載，參數型別不一致，不會產生多載解析歧義；既有公開 API 不調整參數以維持相容。 -->
    <NoWarn>$(NoWarn);RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CloudyWing.Enumeration" Version="0.2.0" />
  </ItemGroup>
</Project>
